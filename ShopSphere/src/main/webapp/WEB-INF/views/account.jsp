<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Your account" scope="request"/>
<%@ include file="partials/header.jspf" %>
<section class="account-page"><div class="account-intro"><span class="eyebrow">WELCOME TO SHOPSPHERE</span><h1>A good find<br>starts here.</h1><p>Sign in to keep your orders together and make checkout a little easier.</p><div class="account-note"><span>✳</span> Your password is stored as a salted hash.</div></div><div class="account-panels">
<c:if test="${not empty error}"><p class="alert alert-error"><c:out value="${error}"/></p></c:if><c:if test="${not empty success}"><p class="alert alert-success"><c:out value="${success}"/></p></c:if>
<form class="form-card" action="${pageContext.request.contextPath}/account" method="post"><span class="eyebrow">YOUR ACCOUNT</span><h2>Sign in</h2><input type="hidden" name="action" value="login"><label>Email address<input type="email" name="email" required maxlength="190" autocomplete="email"></label><label>Password<input type="password" name="password" required maxlength="128" autocomplete="current-password"></label><button class="button button-dark" type="submit">Sign in <span>→</span></button></form>
<form class="form-card form-register" action="${pageContext.request.contextPath}/account" method="post"><span class="eyebrow">NEW HERE</span><h2>Create an account</h2><input type="hidden" name="action" value="register"><label>Your name<input type="text" name="name" required minlength="2" maxlength="100" autocomplete="name"></label><label>Email address<input type="email" name="email" required maxlength="190" autocomplete="email"></label><label>Password<input type="password" name="password" required minlength="8" maxlength="128" autocomplete="new-password"><small>Use at least 8 characters.</small></label><button class="button button-outline" type="submit">Create account <span>→</span></button></form>
</div></section>
<%@ include file="partials/footer.jspf" %>
