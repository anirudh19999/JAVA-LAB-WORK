<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Your orders" scope="request"/>
<%@ include file="partials/header.jspf" %>
<section class="content-page"><span class="eyebrow">THE GOOD THINGS ARE ON THEIR WAY</span><h1>Your orders.</h1><c:if test="${not empty param.placed}"><p class="alert alert-success">Order #<c:out value="${param.placed}"/> was placed successfully. Payment is recorded as mock payment.</p></c:if><c:choose><c:when test="${empty orders}"><div class="empty-state"><h3>No orders yet.</h3><p>There's a first time for everything.</p><a class="button button-dark" href="${pageContext.request.contextPath}/products">Browse products</a></div></c:when><c:otherwise><div class="order-list"><c:forEach var="order" items="${orders}"><article class="order-card"><div><span class="product-brand">ORDER #<c:out value="${order.id}"/></span><h3><c:out value="${order.status}"/></h3><span><fmt:formatDate value="${order.createdAt}" pattern="dd MMM yyyy, HH:mm"/></span></div><strong>₹<fmt:formatNumber value="${order.total}" minFractionDigits="2"/></strong></article></c:forEach></div></c:otherwise></c:choose></section>
<%@ include file="partials/footer.jspf" %>
