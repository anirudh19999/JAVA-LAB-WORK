<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Your bag" scope="request"/>
<%@ include file="partials/header.jspf" %>
<section class="content-page"><span class="eyebrow">YOUR SHOPPING BAG</span><h1>A few good things.</h1>
<c:choose><c:when test="${empty cart}"><div class="empty-state"><h3>Your bag is taking a breather.</h3><p>When something catches your eye, it will be here.</p><a class="button button-dark" href="${pageContext.request.contextPath}/products">Explore the shop</a></div></c:when><c:otherwise><div class="cart-layout"><div class="cart-items"><c:forEach var="entry" items="${cart}"><div class="cart-row"><img src="<c:out value='${entry.key.imageUrl}'/>" alt=""><div class="cart-item-copy"><span class="product-brand"><c:out value="${entry.key.brand}"/></span><h3><c:out value="${entry.key.name}"/></h3><span>₹<fmt:formatNumber value="${entry.key.salePrice}" minFractionDigits="0" maxFractionDigits="2"/> each</span></div><form action="${pageContext.request.contextPath}/cart" method="post" class="quantity-form"><input type="hidden" name="productId" value="${entry.key.id}"><label class="visually-hidden" for="qty-${entry.key.id}">Quantity</label><input id="qty-${entry.key.id}" type="number" name="quantity" min="1" max="99" value="${entry.value}" required><button name="action" value="update">Update</button></form><strong>₹<fmt:formatNumber value="${entry.key.salePrice * entry.value}" minFractionDigits="0" maxFractionDigits="2"/></strong><form action="${pageContext.request.contextPath}/cart" method="post"><input type="hidden" name="productId" value="${entry.key.id}"><button class="remove-button" name="action" value="remove">Remove</button></form></div></c:forEach></div><aside class="summary-card"><span class="eyebrow">ORDER SUMMARY</span><div class="summary-line"><span>Items</span><span><c:out value="${cart.size()}"/></span></div><p class="summary-hint">Shipping and final stock checks are confirmed at checkout.</p><a class="button button-dark full-button" href="${pageContext.request.contextPath}/checkout">Continue to checkout <span>→</span></a></aside></div></c:otherwise></c:choose>
</section>
<%@ include file="partials/footer.jspf" %>
