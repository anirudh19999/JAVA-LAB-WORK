<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Product admin" scope="request"/>
<%@ include file="partials/header.jspf" %>
<section class="content-page"><span class="eyebrow">SHOPSPHERE ADMIN</span><h1>Product studio.</h1><p class="lead">Add a product or tune stock levels. Keep this page for admin accounts only.</p><c:if test="${not empty error}"><p class="alert alert-error"><c:out value="${error}"/></p></c:if><c:if test="${not empty param.saved}"><p class="alert alert-success">Your changes are saved.</p></c:if><div class="admin-layout"><form class="form-card" action="${pageContext.request.contextPath}/admin/products" method="post"><span class="eyebrow">ADD A PIECE</span><input type="hidden" name="action" value="create"><label>Product name<input name="name" maxlength="160" required></label><label>Brand<input name="brand" maxlength="100"></label><label>Description<textarea name="description" rows="3"></textarea></label><div class="field-row"><label>Price (₹)<input type="number" name="price" min="0" step="0.01" required></label><label>Opening stock<input type="number" name="stock" min="0" max="1000000" required></label></div><button class="button button-dark" type="submit">Add product <span>→</span></button></form><div class="admin-table"><div class="table-head"><span>PRODUCT</span><span>PRICE</span><span>STOCK</span></div><c:forEach var="product" items="${products}"><div class="table-row"><div><strong><c:out value="${product.name}"/></strong><small>#<c:out value="${product.id}"/> · <c:choose><c:when test="${product.active}">Active</c:when><c:otherwise>Hidden</c:otherwise></c:choose></small></div><span>₹<fmt:formatNumber value="${product.price}" minFractionDigits="2"/></span><form action="${pageContext.request.contextPath}/admin/products" method="post"><input type="hidden" name="action" value="stock"><input type="hidden" name="productId" value="${product.id}"><label class="visually-hidden" for="stock-${product.id}">Stock</label><input id="stock-${product.id}" name="stock" type="number" min="0" max="1000000" value="${product.stock}"><button class="small-button">Save</button></form></div></c:forEach></div></div></section>
<%@ include file="partials/footer.jspf" %>
