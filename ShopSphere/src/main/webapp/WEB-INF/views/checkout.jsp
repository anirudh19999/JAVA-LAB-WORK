<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Checkout" scope="request"/>
<%@ include file="partials/header.jspf" %>
<section class="content-page"><span class="eyebrow">LAST STEP</span><h1>Make it yours.</h1><c:if test="${not empty error}"><p class="alert alert-error"><c:out value="${error}"/></p></c:if><div class="checkout-layout"><div class="checkout-copy"><p>Review your items, then place your order. This student project uses a mock payment and does not collect payment details.</p><c:forEach var="entry" items="${items}"><div class="checkout-line"><span><c:out value="${entry.key.name}"/> × <c:out value="${entry.value}"/></span><strong>₹<fmt:formatNumber value="${entry.key.salePrice * entry.value}" minFractionDigits="0" maxFractionDigits="2"/></strong></div></c:forEach></div><form class="summary-card" action="${pageContext.request.contextPath}/checkout" method="post"><span class="eyebrow">MOCK CHECKOUT</span><p>Order total is calculated again on the server using current prices and stock.</p><button class="button button-dark full-button" type="submit">Place order <span>→</span></button><a class="back-link" href="${pageContext.request.contextPath}/cart">Back to bag</a></form></div></section>
<%@ include file="partials/footer.jspf" %>
